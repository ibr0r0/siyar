{
  "name": "@siyar/contacts",
  "version": "0.1.0",
  "description": "Community-maintained directory of publicly-published recruitment addresses, plus schema, validator and suppression list.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./directory": "./data/directory.json"
  },
  "files": [
    "src",
    "data"
  ],
  "scripts": {
    "validate": "tsx src/validate.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "suppress": "tsx src/suppress.ts"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24.7.0"
  }
}
